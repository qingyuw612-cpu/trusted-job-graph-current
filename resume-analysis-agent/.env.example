# ============ LLM API 配置（并列 Switch 模式）============
# LLM_PROVIDER 是切换键：deepseek | iflytek | openai | custom。
# 每个供应商一个独立配置块 {PROVIDER}_*，互不干扰；只读取当前所选供应商的块。
# 不再使用共享的 LLM_API_KEY / LLM_MODEL / LLM_BASE_URL / LLM_EXTRA_BODY。
LLM_PROVIDER=deepseek
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---- DeepSeek 配置块 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=        # 留空用预设 https://api.deepseek.com/v1
DEEPSEEK_MODEL=           # 留空用预设 deepseek-chat
DEEPSEEK_EXTRA_BODY=      # 可选，推理参数，如 {"thinking":{"type":"enabled"}}

# ---- 讯飞星火配置块 ----
IFLYTEK_API_KEY=
IFLYTEK_BASE_URL=         # 留空用预设 https://spark-api-open.xf-yun.com/v1
IFLYTEK_MODEL=            # 留空用预设 4.0Ultra
IFLYTEK_EXTRA_BODY=       # 可选，推理参数，如 {"thinking":{"type":"enabled"}}

# ---- OpenAI 配置块 ----
OPENAI_API_KEY=
OPENAI_BASE_URL=          # 留空用预设 https://api.openai.com/v1
OPENAI_MODEL=             # 留空用预设 gpt-4o
OPENAI_EXTRA_BODY=        # 可选

# ---- 自定义 OpenAI 兼容服务配置块（base_url / model 必填）----
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_EXTRA_BODY=        # 可选

# 数据源后端：memory（内嵌示例，开箱即用）| neo4j（加载图谱 134 Role）
STORE_BACKEND=memory

# Neo4j 图数据库配置（STORE_BACKEND=neo4j 时必填）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
ROLE_CACHE_TTL_SECONDS=300
