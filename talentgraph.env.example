# Copy to a root-only file on the final server; never commit the filled file.
TG_DOMAIN=talentgraphagent.site
TG_TLS_CERT=/etc/letsencrypt/live/talentgraphagent.site/fullchain.pem
TG_TLS_KEY=/etc/letsencrypt/live/talentgraphagent.site/privkey.pem
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
# If Neo4j is an existing native service, set e.g. neo4j.service.
NEO4J_UNIT=
# At least 12 ASCII characters; do not include spaces, quotes or slash.
NEO4J_PASSWORD=replace-with-a-random-secret
# Set only for temporary pre-certificate validation; production must be 0.
TG_HTTP_ONLY=0
# Automatic maintenance: full 73-keyword scan every 12 hours. Each platform
# stops after this many newly collected JD rows in one cycle.
TG_CRAWLER_INTERVAL=12h
TG_CRAWLER_SCAN_MODE=full
TG_CRAWLER_PAGES=3
TG_CRAWLER_COLLECTION_LIMIT=1500
TG_CRAWLER_PIPELINE_LIMIT=0
TG_CRAWLER_NEW_ROLE_LIMIT=50
TG_CRAWLER_ABILITY_CHANGE_LIMIT=40
# Keep scheduled role evolution in the resident API task registry.
EVOLUTION_API_URL=http://127.0.0.1:8070/api/v1/evolution
# Required for automatic five-dimension extraction and publish.
IFLYTEK_SPARK_API_PASSWORD=
IFLYTEK_SPARK_MODEL=lite
IFLYTEK_SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
