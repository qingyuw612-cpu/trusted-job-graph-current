# Host port for the web application.
APP_PORT=8080

# Leave empty to use the small Docker Hub base image.
# If Docker Hub is blocked, set:
# BASE_IMAGE=mcr.microsoft.com/devcontainers/python:1-3.12-bookworm
BASE_IMAGE=python:3.12-slim

# Five-dimension ability extraction through iFlytek Spark HTTP API.
# Keep the real key only in the local environment; never commit it.
IFLYTEK_SPARK_API_PASSWORD=
IFLYTEK_SPARK_MODEL=
IFLYTEK_SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
